{
  "name": "pharos",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pharos": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:playwright-contract": "vitest run --config vitest.playwright-contract.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "ajv": "8.20.0",
    "canonicalize": "2.1.0",
    "commander": "14.0.1",
    "playwright": "1.63.0"
  }
}
