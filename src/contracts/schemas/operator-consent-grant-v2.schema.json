{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharos.dev/contracts/operator-consent-grant/2",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "decision", "binding", "challengeId", "expiresAtEpochMs", "hostId", "keyId", "algorithm", "signature"],
  "properties": {
    "contract": { "const": "pharos.operator-consent-grant/2" },
    "decision": { "enum": ["granted", "declined"] },
    "binding": { "$ref": "#/$defs/binding" },
    "challengeId": { "$ref": "#/$defs/text" },
    "expiresAtEpochMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "hostId": { "$ref": "#/$defs/text" }, "keyId": { "$ref": "#/$defs/text" },
    "algorithm": { "const": "ed25519" },
    "signature": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "projectId", "beaconId", "draftId", "expectedRevision", "semanticHash", "requestId", "staleOriginAcknowledged", "reviewed"],
      "properties": {
        "action": { "const": "approve" }, "projectId": { "$ref": "#/$defs/text" }, "beaconId": { "$ref": "#/$defs/text" },
        "draftId": { "$ref": "#/$defs/text" }, "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "semanticHash": { "$ref": "#/$defs/text" }, "requestId": { "$ref": "#/$defs/text" },
        "staleOriginAcknowledged": { "const": true },
        "reviewed": {
          "type": "object", "additionalProperties": false,
          "required": ["activeVersionId", "activeSemanticHash", "comparisonDigest"],
          "properties": {
            "activeVersionId": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
            "activeSemanticHash": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
            "comparisonDigest": { "$ref": "#/$defs/text" }
          },
          "oneOf": [
            { "properties": { "activeVersionId": { "type": "null" }, "activeSemanticHash": { "type": "null" } } },
            { "properties": { "activeVersionId": { "type": "string" }, "activeSemanticHash": { "type": "string" } } }
          ]
        }
      }
    }
  }
}
