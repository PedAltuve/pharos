{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharos.dev/contracts/operator-consent-grant/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "decision", "binding", "challengeId", "expiresAtEpochMs", "hostId", "keyId", "algorithm", "signature"],
  "properties": {
    "contract": { "const": "pharos.operator-consent-grant/1" },
    "decision": { "enum": ["granted", "declined"] },
    "binding": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["action", "projectId", "beaconId", "draftId", "expectedRevision", "semanticHash", "requestId"], "properties": { "action": { "const": "approve" }, "projectId": { "$ref": "#/$defs/text" }, "beaconId": { "$ref": "#/$defs/text" }, "draftId": { "$ref": "#/$defs/text" }, "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "semanticHash": { "$ref": "#/$defs/text" }, "requestId": { "$ref": "#/$defs/text" }, "staleOriginAcknowledged": { "type": "boolean" } } },
      { "type": "object", "additionalProperties": false, "required": ["action", "projectId", "beaconId", "expectedActiveVersion", "reason", "requestId"], "properties": { "action": { "const": "revoke" }, "projectId": { "$ref": "#/$defs/text" }, "beaconId": { "$ref": "#/$defs/text" }, "expectedActiveVersion": { "$ref": "#/$defs/text" }, "reason": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)$" }, "requestId": { "$ref": "#/$defs/text" } } }
    ] },
    "challengeId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "expiresAtEpochMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "hostId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "keyId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "algorithm": { "const": "ed25519" },
    "signature": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": { "text": { "type": "string", "minLength": 1, "maxLength": 256 } }
}
